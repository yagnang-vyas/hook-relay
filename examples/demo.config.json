{
  "sources": [
    {
      "id": "github",
      "secretEnv": "GITHUB_WEBHOOK_SECRET",
      "scheme": { "type": "hmac-sha256", "header": "X-Hub-Signature-256", "format": "sha256=hex" },
      "deliveryIdHeader": "X-GitHub-Delivery",
      "targets": ["echo"]
    },
    {
      "id": "payments",
      "secretEnv": "PAYMENTS_WEBHOOK_SECRET",
      "scheme": {
        "type": "timestamped-hmac-sha256",
        "header": "X-Signature",
        "toleranceSeconds": 300
      },
      "deliveryIdHeader": "X-Event-Id",
      "targets": ["echo"]
    }
  ],
  "targets": [
    {
      "id": "echo",
      "url": "http://echo:8080/webhooks",
      "timeoutMs": 5000,
      "maxAttempts": 8,
      "backoff": { "baseMs": 1000, "maxMs": 60000 }
    }
  ],
  "network": { "allowPrivateTargets": ["echo"], "allowHttp": true },
  "maxBodyBytes": 1048576,
  "retentionDays": 14
}
