# Variable names only; generate real values yourself (for example: openssl rand -hex 32).
# Used by compose.yaml; the app builds DATABASE_URL from it.
POSTGRES_PASSWORD=

# Required when running without compose.
DATABASE_URL=
ADMIN_API_KEY=
RELAY_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_SECRET=

# Optional (defaults shown in README)
# DATABASE_SCHEMA=
# PORT=
# HOST=
# LOG_LEVEL=
# WORKER_ENABLED=
# WORKER_BATCH_SIZE=
# WORKER_POLL_INTERVAL_MS=
# LEASE_SECONDS=
# SHUTDOWN_GRACE_MS=
# CONFIG_PATH=
# MIGRATIONS_DIR=
